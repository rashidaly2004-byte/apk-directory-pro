<?xml version="1.0"?>
<ruleset name="APK Directory Core">
    <description>WordPress Coding Standards for APK Directory Core</description>
    <file>./src</file>
    <file>./apk-directory-core.php</file>
    <rule ref="WordPress"/>
    <config name="testVersion" value="8.1-"/>
    <!-- PSR-4 class file names -->
    <rule ref="WordPress.Files.FileName">
        <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    </rule>
    <!-- Doc comments not required on every symbol -->
    <rule ref="Generic.Commenting.DocComment">
        <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment">
        <exclude name="Squiz.Commenting.FunctionComment.Missing"/>
    </rule>
    <rule ref="Squiz.Commenting.ClassComment">
        <exclude name="Squiz.Commenting.ClassComment.Missing"/>
    </rule>
    <rule ref="Squiz.Commenting.FileComment">
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
    </rule>
    <rule ref="Squiz.Commenting.VariableComment">
        <exclude name="Squiz.Commenting.VariableComment.Missing"/>
    </rule>
    <!-- REST/AJAX handlers verify auth separately -->
    <rule ref="WordPress.Security.NonceVerification">
        <exclude name="WordPress.Security.NonceVerification.Missing"/>
    </rule>
    <!-- Yoda conditions optional for readability -->
    <rule ref="WordPress.PHP.YodaConditions">
        <severity>0</severity>
    </rule>
    <!-- Custom table queries use prepared statements where possible -->
    <rule ref="WordPress.DB.DirectDatabaseQuery">
        <severity>0</severity>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL">
        <exclude name="WordPress.DB.PreparedSQL.InterpolatedNotPrepared"/>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL.NotPrepared">
        <severity>0</severity>
    </rule>
    <rule ref="Universal.Operators.DisallowShortTernary">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.MissingParamComment">
        <severity>0</severity>
    </rule>
</ruleset>
