{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#18a957", "name": "Primary" },
				{ "slug": "primary-dark", "color": "#128345", "name": "Primary Dark" },
				{ "slug": "accent", "color": "#2563eb", "name": "Accent" },
				{ "slug": "background", "color": "#f5f7fa", "name": "Background" },
				{ "slug": "surface", "color": "#ffffff", "name": "Surface" },
				{ "slug": "text", "color": "#17202a", "name": "Text" },
				{ "slug": "muted", "color": "#667085", "name": "Muted" },
				{ "slug": "border", "color": "#e4e7ec", "name": "Border" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif",
					"name": "System",
					"slug": "system"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "medium", "size": "1rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.5rem", "name": "Extra Large" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"spacing": {
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "1", "size": "4px", "name": "1" },
				{ "slug": "2", "size": "8px", "name": "2" },
				{ "slug": "3", "size": "12px", "name": "3" },
				{ "slug": "4", "size": "16px", "name": "4" },
				{ "slug": "6", "size": "24px", "name": "6" },
				{ "slug": "8", "size": "32px", "name": "8" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--adp-bg)",
			"text": "var(--adp-text)"
		},
		"typography": {
			"fontFamily": "var(--adp-font)",
			"fontSize": "16px",
			"lineHeight": "1.55"
		}
	}
}
